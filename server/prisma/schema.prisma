generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  status       UserStatus   @default(ACTIVE)

  failedLoginAttempts Int @default(0)

  roles         UserRole[]
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  profile       UserProfile?

  stories    Story[]
  epapers    EPaper[]
  storyEdits StoryVersion[]
  polls      Poll[]
  pollVotes  PollVote[]
  reports    Report[]
  auditLogs  AuditLog[]

  managerId    String?
  manager      User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates User[]  @relation("UserManager")

  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  priorityLogs PriorityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model UserProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  designation Designation
  jobType     JobType
  location    String?
  bio         String?
  avatar      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RoleModel {
  id          String           @id @default(cuid())
  name        Role             @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id             String           @id @default(cuid())
  key            String           @unique
  label          String
  rolePermission RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revoked          Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Story {
  id         String      @id @default(cuid())
  title      String
  shortTitle String
  slug       String      @unique
  excerpt    String
  content    Json
  highlights Json?
  storyType  StoryType
  status     StoryStatus
  priority   Int         @default(0)
  scheduleAt DateTime?
  authorId   String
  topicTags  String[]

  mandal       String?
  district     String?
  place        String?
  photoCaption String?
  photoCredit  String?

  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  assets       StoryAsset[] 
  sections     StorySection[]
  versions     StoryVersion[]
  meta         MetaTag?
  priorityLogs PriorityLog[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([priority])
}

model StoryVersion {
  id       String  @id @default(cuid())
  storyId  String
  content  Json
  editedBy String
  reason   String?

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  editor User  @relation(fields: [editedBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Section {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  stories      StorySection[]
  priorityLogs PriorityLog[]
}

model StorySection {
  id         String  @id @default(cuid())
  storyId    String
  sectionId  String
  priority   Int     @default(0)
  isFeatured Boolean @default(false)

  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([storyId, sectionId])
  @@index([priority])
  @@index([sectionId])
}

model PriorityLog {
  id          String @id @default(cuid())
  storyId     String
  sectionId   String
  oldPriority Int
  newPriority Int
  changedById String

  story   Story   @relation(fields: [storyId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  user    User    @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())
}

model Poll {
  id        String       @id @default(cuid())
  storyId   String?
  question  String
  startsAt  DateTime
  endsAt    DateTime
  status    PollStatus   @default(INACTIVE)
  createdBy String
  creator   User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  text   String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String?
  ipAddress String?
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([pollId, userId])
  @@unique([pollId, ipAddress])
}


model StoryAsset {
  id       String @id @default(cuid())
  storyId  String
  mediaId  String
  order    Int
  isCover  Boolean @default(false)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([storyId, order])
}


model MediaAsset {
  id         String   @id @default(cuid())
  type       AssetType
  fileUrl    String
  publicId   String
  mimeType   String
  size       Int
  metadata   Json?
  uploadedBy String
  createdAt  DateTime @default(now())

  storyLinks StoryAsset[]
  pageLinks  PageAsset[]

  epaperPdf EPaper?
}


model EPaper {
  id        String @id @default(cuid())
  title     String
  type      EPaperType
  status    EPaperStatus @default(PUBLISHED)
  authorId  String
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pdfMediaId String?  @unique
  pdf        MediaAsset? @relation(fields: [pdfMediaId], references: [id], onDelete: SetNull)
  pages      PageAsset[]

  createdAt DateTime @default(now())
}


model PageAsset {
  id        String @id @default(cuid())
  epaperId String
  mediaId  String
  order    Int

  epaper EPaper @relation(fields: [epaperId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([epaperId, order])
}


model ContactMessage {
  id        String  @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String?
  ipAddress String?

  createdAt DateTime @default(now())
}

model Report {
  id          String @id @default(cuid())
  type        String
  filters     Json
  generatedBy String

  user User @relation(fields: [generatedBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AuditLog {
  id        String  @id @default(cuid())
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ipAddress String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  isActive Boolean @default(true)

  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
}

model MetaTag {
  id              String  @id @default(cuid())
  storyId         String  @unique
  metaKeywords    String?
  metaDescription String
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  googleBot       String?
  excludeIA       Boolean @default(false)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

enum StoryStatus {
  DRAFT
  SUBMITTED
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  REJECTED
}

enum StoryType {
  NEWS
  BLOG
  MAGAZINE
  VIDEO
}

enum AssetType {
  IMAGE
  VIDEO
  PDF
  AUDIO
}

enum PollStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

enum EPaperType {
  E_PAPER
  MAGAZINE
}

enum EPaperStatus {
  PUBLISHED
  ARCHIVED
}

enum Role {
  ADMIN
  SUB_ADMIN
  EDITOR
}

enum Designation {
  OPERATIONS_MANAGER
  COMMUNITY_MODERATOR
  COMPLIANCE_OFFICER
  EDITOR_IN_CHIEF
  MANAGING_EDITOR
  SENIOR_EDITOR
  COPY_EDITOR
  SEO_EDITOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERN
  FREELANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  WHATSAPP
}
